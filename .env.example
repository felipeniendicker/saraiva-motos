# Backend — banco e servidor
DB_URL=jdbc:mysql://HOST:3306/DATABASE
DB_USERNAME=usuario_do_banco
DB_PASSWORD=substitua_por_uma_senha_segura
PORT=8080

# Backend — autenticação e bootstrap
JWT_SECRET=substitua_por_um_segredo_aleatorio_com_32_bytes_ou_mais
JWT_EXPIRATION_MS=28800000
INITIAL_USER_EMAIL=administrador@example.com
INITIAL_USER_PASSWORD=substitua_por_uma_senha_inicial_segura

# Backend — origem pública do frontend; separe múltiplas origens com vírgula
CORS_ALLOWED_ORIGINS=https://frontend.example.com
FRONTEND_PUBLIC_URL=https://frontend.example.com

# Backend — integrações externas
UPCITEMDB_ENABLED=true
UPCITEMDB_BASE_URL=https://api.upcitemdb.com/prod/trial
UPCITEMDB_CONNECT_TIMEOUT=2500ms
UPCITEMDB_READ_TIMEOUT=4000ms
TAVILY_ENABLED=false
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
TAVILY_CONNECT_TIMEOUT=2500ms
TAVILY_READ_TIMEOUT=4000ms

# Frontend — variável pública usada durante o build Vite
VITE_API_URL=https://backend.example.com
